# Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# Backend API Configuration
BACKEND_URL=http://localhost:8080

# AI Engine
# rule: existing rule-based analyzer
# ollama: rule-based analyzer + local Ollama LLM enhancement
AI_ENGINE=rule
OLLAMA_BASE_URL=http://localhost:11434
# 7b는 모델 메모리 약 4.7GB. 메모리가 부족하면 qwen2.5:3b (약 2.0GB, 빠르지만 덜 정확)
OLLAMA_MODEL=qwen2.5:7b
# CPU만 쓰면 회의록 1건에 1~4분 걸린다. 백엔드 AI_MODULE_READ_TIMEOUT_MS는 이보다 길게 둔다
OLLAMA_TIMEOUT_SECONDS=300
OLLAMA_TEMPERATURE=0.1

# Embedding Classifier
# true: use open-source BGE-M3 embedding model for mail/action classification
# false: use rule-based analyzer only
EMBEDDING_CLASSIFIER_ENABLED=false
EMBEDDING_MODEL_NAME=BAAI/bge-m3
EMBEDDING_ACTION_THRESHOLD=0.52
EMBEDDING_BUSINESS_THRESHOLD=0.50

# Entity Extractor
# true: use GLiNER open-source NER model for customer/product/attendee hints
# false: use rule-based extraction only
GLINER_ENABLED=false
GLINER_MODEL_NAME=urchade/gliner_multi-v2.1
GLINER_THRESHOLD=0.35

# LLM Provider
# ollama: 로컬 Ollama만 사용 (기본값, 무료)
# openai: OpenAI 우선 → 실패·예산 초과 시 Ollama → 그래도 실패하면 규칙/템플릿
# OPENAI_API_KEY가 비어 있으면 openai로 설정해도 Ollama만 사용한다 (과금 없음)
LLM_PROVIDER=ollama
OPENAI_API_KEY=
OPENAI_MODEL_ANALYSIS=gpt-5.6-luna
OPENAI_MODEL_REPLY=gpt-5.6-terra
OPENAI_TIMEOUT_SECONDS=30
# 서버 프로세스 기준 월 예상 비용 상한(USD). 재시작 시 0부터 다시 센다 → OpenAI 대시보드 예산 한도도 반드시 설정
OPENAI_MONTHLY_BUDGET_USD=10
# 비워두면 전송하지 않음. 예: low
OPENAI_REASONING_EFFORT=
