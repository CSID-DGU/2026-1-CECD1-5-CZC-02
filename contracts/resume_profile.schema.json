{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "resume_profile.schema.json",
  "title": "ResumeProfile — 이력서에서 뽑은 인력 후보 한 명 (AI 모듈 → 백엔드 talent)",
  "description": "이력서 한 건을 정리한 결과. 인력 후보 풀에 등록할 초안이며 고객 담당자(person.schema.json)와 섞지 않는다. 뽑은 값은 모두 원문 근거(evidence)와 출처(source: RULE·LLM·HUMAN)를 가진다. 모르는 값은 추측하지 않고 null 또는 빈 배열로 두고 missingFields에 적는다. 총 경력·투입 가능일·기술명 통일은 규칙으로 계산한다. 사람이 확인 화면에서 확정하기 전에는 DRAFT.",
  "type": "object",
  "required": [
    "profileId",
    "sourceRefs",
    "format",
    "name",
    "birthYear",
    "grade",
    "certifications",
    "educations",
    "careers",
    "projects",
    "skills",
    "industries",
    "totalCareer",
    "availableFrom",
    "referenceDate",
    "missingFields",
    "status",
    "generatedBy"
  ],
  "additionalProperties": false,
  "properties": {
    "profileId": {
      "type": "string",
      "pattern": "^rp_[0-9a-z_]+$",
      "description": "인력 후보 프로필 ID. DB 저장 후에는 rp_ + DB PK (예: rp_17), 저장 전에는 rp_draft 또는 임의 번호 (예: rp_001)"
    },
    "sourceRefs": {
      "type": "array",
      "minItems": 1,
      "description": "이 프로필을 만든 원본 이력서. 같은 사람의 이력서를 사람이 합치면 여러 개가 된다. 원본은 지우지 않는다",
      "items": {
        "type": "object",
        "required": ["sourceId", "sourceType"],
        "additionalProperties": false,
        "properties": {
          "sourceId": { "type": "string", "minLength": 1 },
          "sourceType": { "enum": ["RESUME_FILE", "MANUAL_INPUT"] },
          "fileName": { "type": ["string", "null"], "description": "올린 파일 이름. 화면 표시용" }
        }
      }
    },
    "format": {
      "enum": ["TABLE_CARD", "OTHER_TABLE", "FREE_TEXT"],
      "description": "양식 판별 결과(규칙). TABLE_CARD=프로젝트 표 양식(개인이력카드 등, 표는 규칙으로 읽음), OTHER_TABLE=다른 표 양식, FREE_TEXT=줄글. 뒤의 둘은 로컬 LLM이 보조한다"
    },
    "name": { "$ref": "#/$defs/nullableText", "description": "이름. 호칭 제외" },
    "birthYear": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": ["value", "evidence", "source"],
          "additionalProperties": false,
          "properties": {
            "value": { "type": "integer", "minimum": 1900, "maximum": 2100 },
            "evidence": { "$ref": "#/$defs/evidence" },
            "source": { "$ref": "#/$defs/source" }
          }
        }
      ],
      "description": "출생 연도만 둔다(월·일은 저장하지 않음). 같은 사람 찾기의 보조 단서"
    },
    "grade": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": ["value", "evidence", "source"],
          "additionalProperties": false,
          "properties": {
            "value": { "enum": ["JUNIOR", "INTERMEDIATE", "ADVANCED", "EXPERT"], "description": "초급·중급·고급·특급" },
            "evidence": { "$ref": "#/$defs/evidence" },
            "source": { "$ref": "#/$defs/source" }
          }
        }
      ],
      "description": "기술 등급. 이력서에 적혀 있을 때만 채우고 경력으로 추정하지 않는다"
    },
    "certifications": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "acquiredOn", "evidence", "source"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "acquiredOn": { "$ref": "#/$defs/nullableMonth" },
          "evidence": { "$ref": "#/$defs/evidence" },
          "source": { "$ref": "#/$defs/source" }
        }
      }
    },
    "educations": {
      "type": "array",
      "description": "교육 이수·학력",
      "items": {
        "type": "object",
        "required": ["name", "institution", "period", "evidence", "source"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "institution": { "type": ["string", "null"] },
          "period": { "$ref": "#/$defs/period" },
          "evidence": { "$ref": "#/$defs/evidence" },
          "source": { "$ref": "#/$defs/source" }
        }
      }
    },
    "careers": {
      "type": "array",
      "description": "근무 이력 (회사 단위)",
      "items": {
        "type": "object",
        "required": ["company", "position", "duty", "period", "evidence", "source"],
        "additionalProperties": false,
        "properties": {
          "company": { "type": ["string", "null"] },
          "position": { "type": ["string", "null"], "description": "직위" },
          "duty": { "type": ["string", "null"], "description": "담당 업무" },
          "period": { "$ref": "#/$defs/period" },
          "evidence": { "$ref": "#/$defs/evidence" },
          "source": { "$ref": "#/$defs/source" }
        }
      }
    },
    "projects": {
      "type": "array",
      "description": "프로젝트 이력. 개발환경은 이력서에 적힌 표기 그대로 두고, 통일한 기술명은 skills에 둔다",
      "items": {
        "type": "object",
        "required": ["name", "period", "client", "employer", "role", "duty", "industry", "environment", "evidence", "source"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": ["string", "null"] },
          "period": { "$ref": "#/$defs/period" },
          "client": { "type": ["string", "null"], "description": "고객사(발주처)" },
          "employer": { "type": ["string", "null"], "description": "근무(소속) 회사" },
          "role": { "type": ["string", "null"], "description": "역할. 예: 개발, PL, PM" },
          "duty": { "type": ["string", "null"], "description": "수행 업무·응용 분야" },
          "industry": { "type": ["string", "null"], "description": "개발 분야(산업) 칸의 표기 그대로" },
          "environment": {
            "type": "object",
            "required": ["machines", "os", "languages", "dbms", "tools", "others"],
            "additionalProperties": false,
            "properties": {
              "machines": { "$ref": "#/$defs/stringList", "description": "기종" },
              "os": { "$ref": "#/$defs/stringList" },
              "languages": { "$ref": "#/$defs/stringList", "description": "언어·프레임워크" },
              "dbms": { "$ref": "#/$defs/stringList" },
              "tools": { "$ref": "#/$defs/stringList" },
              "others": { "$ref": "#/$defs/stringList", "description": "통신·기타" }
            }
          },
          "evidence": { "$ref": "#/$defs/evidence" },
          "source": { "$ref": "#/$defs/source" }
        }
      }
    },
    "skills": {
      "type": "array",
      "description": "기술명 사전(규칙)으로 통일한 기술. 사전에 없는 표기는 known=false로 원래 표기를 name에 둔다",
      "items": {
        "type": "object",
        "required": ["name", "category", "known", "raw", "projectCount", "evidence", "source"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "minLength": 1, "description": "통일한 이름. 예: Java, Oracle" },
          "category": { "enum": ["LANGUAGE", "FRAMEWORK", "DBMS", "OS", "MACHINE", "TOOL", "MIDDLEWARE", "OTHER"] },
          "known": { "type": "boolean", "description": "기술명 사전에 있는 표기인지" },
          "raw": { "$ref": "#/$defs/stringList", "description": "이력서에 적힌 표기들. 예: [\"JAVA\", \"java\"]" },
          "projectCount": { "type": "integer", "minimum": 0, "description": "이 기술이 나온 프로젝트 수" },
          "evidence": { "$ref": "#/$defs/evidence" },
          "source": { "$ref": "#/$defs/source" }
        }
      }
    },
    "industries": {
      "type": "array",
      "description": "경험한 산업. 표의 개발 분야 칸은 RULE, 줄글에서 읽은 것은 LLM",
      "items": {
        "type": "object",
        "required": ["name", "evidence", "source"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "minLength": 1, "description": "통일한 산업명. 예: 금융, 공공, 제조" },
          "evidence": { "$ref": "#/$defs/evidence" },
          "source": { "$ref": "#/$defs/source" }
        }
      }
    },
    "totalCareer": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": ["months", "basis", "periodCount"],
          "additionalProperties": false,
          "properties": {
            "months": { "type": "integer", "minimum": 0 },
            "basis": { "enum": ["PROJECTS", "CAREERS"], "description": "프로젝트 기간을 합쳤는지, 근무 이력 기간을 합쳤는지" },
            "periodCount": { "type": "integer", "minimum": 0, "description": "합친 기간 수" }
          }
        }
      ],
      "description": "총 경력(규칙). 겹친 기간은 한 번만 센다. 진행 중이면 referenceDate의 달까지. 기간을 하나도 못 읽으면 null"
    },
    "availableFrom": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": ["date", "basis", "evidence"],
          "additionalProperties": false,
          "properties": {
            "date": { "$ref": "#/$defs/nullableDate" },
            "basis": {
              "enum": ["ONGOING_PROJECT_END", "NO_ONGOING_PROJECT", "ONGOING_WITHOUT_END"],
              "description": "ONGOING_PROJECT_END=진행 중 프로젝트 종료 달의 다음 달 1일, NO_ONGOING_PROJECT=진행 중 프로젝트 없음(date null, 확인 필요), ONGOING_WITHOUT_END=진행 중인데 종료일 없음(date null, 확인 필요)"
            },
            "evidence": { "type": ["string", "null"], "description": "기준이 된 프로젝트 줄 원문" }
          }
        }
      ],
      "description": "투입 가능일(규칙). 프로젝트 기간을 하나도 못 읽으면 null"
    },
    "referenceDate": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "진행 중 여부·총 경력을 계산한 기준일 (보통 이력서를 올린 날)"
    },
    "missingFields": {
      "type": "array",
      "items": { "type": "string" },
      "description": "원문에서 찾지 못해 비워 둔 항목 이름. 예: name, birthYear, grade, projects"
    },
    "status": {
      "enum": ["DRAFT", "CONFIRMED"],
      "description": "사람이 확인 화면에서 확정하기 전에는 DRAFT"
    },
    "generatedBy": {
      "enum": ["RULE", "LLM", "HYBRID", "HUMAN"],
      "description": "RULE=표 규칙만, LLM=로컬 LLM만, HYBRID=표 규칙 + 남은 칸 로컬 LLM, HUMAN=사람이 직접 입력"
    },
    "llmModel": { "type": ["string", "null"] },
    "isSynthetic": { "type": "boolean", "description": "가짜 데이터 표시. 레포 안의 예시·시드는 true" }
  },
  "$defs": {
    "source": { "enum": ["RULE", "LLM", "HUMAN"] },
    "evidence": {
      "type": "string",
      "minLength": 1,
      "description": "근거가 된 원문 그대로 (표는 칸 글자 또는 칸을 ' | '로 이은 줄)"
    },
    "stringList": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "nullableMonth": {
      "type": ["string", "null"],
      "pattern": "^\\d{4}-\\d{2}$",
      "description": "YYYY-MM. 모르면 null"
    },
    "nullableDate": {
      "type": ["string", "null"],
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "period": {
      "type": "object",
      "required": ["start", "end", "ongoing"],
      "additionalProperties": false,
      "properties": {
        "start": { "$ref": "#/$defs/nullableMonth" },
        "end": { "$ref": "#/$defs/nullableMonth", "description": "진행 중이고 종료 예정이 없으면 null" },
        "ongoing": { "type": "boolean", "description": "'현재'·'진행 중'이라고 적혀 있거나 종료가 referenceDate 이후" }
      }
    },
    "nullableText": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": ["value", "evidence", "source"],
          "additionalProperties": false,
          "properties": {
            "value": { "type": "string", "minLength": 1 },
            "evidence": { "$ref": "#/$defs/evidence" },
            "source": { "$ref": "#/$defs/source" }
          }
        }
      ]
    }
  }
}
